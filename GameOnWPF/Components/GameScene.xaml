<UserControl x:Class="GameOnWPF.Components.GameScene"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             Loaded="OnLoaded">

    <Grid x:Name="RootGrid">

        <Canvas x:Name="Screen"
                Background="Black"
                ClipToBounds="True"
                Panel.ZIndex="0">

            <Canvas x:Name="World"
                    Panel.ZIndex="0">

                <Image x:Name="ColorMap"
                       Stretch="None"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                <Image x:Name="Player"
                       Width="48"
                       Height="48"
                       Stretch="Uniform"
                       RenderTransformOrigin="0.5,0.5"/>
            </Canvas>

            <Button Click="OnPauseClick"
                    Width="64"
                    Height="64"
                    FontSize="32"
                    Background="#222"
                    Foreground="White"
                    BorderBrush="White"
                    BorderThickness="2"
                    Content="| |"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Margin="8"
                    Panel.ZIndex="5"/>
        </Canvas>


        <Border x:Name="PauseBackdrop"
                Background="#88000000"
                Visibility="Collapsed"
                Panel.ZIndex="50"/>


        <Border x:Name="PauseOverlay"
                Width="320"
                Height="220"
                Background="#222"
                BorderBrush="White"
                BorderThickness="2"
                CornerRadius="12"
                Padding="20"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Panel.ZIndex="100">

            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="Paused"
                           FontSize="28"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <Button Content="Resume"
                        Width="120"
                        Margin="5"
                        Click="OnResumeClick"/>

                <Button Content="Exit"
                        Width="120"
                        Margin="5"
                        Click="OnExitClick"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
